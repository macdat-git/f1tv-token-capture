{
  "manifest_version": 3,
  "name": "F1TV Token Capture (companion)",
  "version": "1.1.0",
  "description": "Reads your own F1TV sign-in token so you can give it to the F1 Sensor integration in Home Assistant. Does nothing anywhere else.",
  "permissions": ["cookies", "clipboardWrite"],
  "host_permissions": ["https://*.formula1.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Copy F1TV token" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*/local/f1tv-token*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
